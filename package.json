{
	"name": "degree-audit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"wasm:build": "wasm-pack build crates/audit-wasm --target web --out-dir ../../src/lib/wasm --out-name degree_audit",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:run": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"test:e2e": "playwright test",
		"lint": "biome check",
		"format": "biome format --write",
		"fix": "biome check --write",
		"deps:check": "bun outdated",
		"deps:audit": "bun audit --audit-level=moderate"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "2.5.4",
		"@iconify-json/ic": "^1.2.4",
		"@inlang/paraglide-js": "^2.21.0",
		"@inlang/plugin-message-format": "^4.4.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@vitest/coverage-istanbul": "4.1.10",
		"fast-check": "4.9.0",
		"happy-dom": "20.10.6",
		"lighthouse": "^13.4.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"zod": "^4.3.6"
	}
}
